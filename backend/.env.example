# Server Configuration
PORT=4001
DATABASE_PATH=./data/runecortex.db

# Plugin Configuration
# Enable/disable individual features

# Jellyfin API (for Infuse compatibility)
JELLYFIN_ENABLED=true
SERVER_NAME=RuneCortex Media Server
SERVER_ID=runecortex-001

# DLNA/UPnP Server
DLNA_ENABLED=true
SSDP_ENABLED=true
SSDP_PORT=1900

# M3U/M3U8 Playlist Generation
M3U_ENABLED=true

# Thumbnail Generation Performance
THUMBNAIL_MAX_CONCURRENT=8
THUMBNAIL_BATCH_SIZE=50
THUMBNAIL_BATCH_WAIT_SECONDS=0
THUMBNAIL_DEBOUNCE_SECONDS=5
THUMBNAIL_COOLDOWN_SECONDS=0

# Media Watcher
WATCHER_ENABLED=true

# Perceptual Hash Configuration
PHASH_ENABLED=true
PHASH_CACHE_DIR=./cache/phash

# Location Services
LOCATION_SERVICES_ENABLED=false
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here